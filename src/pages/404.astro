---
import Base from '../layouts/Base.astro';
import { site } from '../lib/content';
---

<Base title="Page not found" description="That page is not on the Cheek Middle School Band site.">
  <section class="section">
    <div class="wrap">
      <p class="kicker">{site.shortName}</p>
      <h1>Page not found</h1>
      <p>That address is not on this site. Try the menu, or go back to the home page.</p>
      <p><a class="btn btn-ink" href="/">Back to the band home page</a></p>
    </div>
  </section>
</Base>
