---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import { site } from '../lib/content';
---

<Base
  title="Gallery"
  description="Photographs from Cheek Middle School Band rehearsals, concerts, and time together."
>
  <PageHero
    kicker="Photos and video"
    title="Gallery"
    lede="Rehearsals, concerts, and time outside the band room. These photos were posted by the band. Student names are not listed. More pictures can be added in the site data file."
    photo="28-winter-concert-audience-view-1"
    photoAlt="Winter concert from the side of the stage, a director conducting"
  />

  <section class="section">
    <div class="wrap grid gallery">
      {
        site.gallery.map((item) => (
          <figure class="shot">
            <Photo
              slug={item.slug}
              alt={item.alt}
              sizes="(min-width: 900px) 33vw, (min-width: 640px) 50vw, 100vw"
            />
            <figcaption>{item.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="wrap">
      <h2>{site.video.title}</h2>
      <div class="video">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${site.video.id}`}
          title={site.video.title}
          loading="lazy"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
      <p class="muted">
        {site.video.credit}
        <a href={`https://www.youtube.com/watch?v=${site.video.id}`}>Open on YouTube</a>.
      </p>
    </div>
  </section>
</Base>
