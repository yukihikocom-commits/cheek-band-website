---
import { site } from '../lib/content';

interface Props {
  kicker: string;
  title: string;
  lede: string;
}

const { kicker, title, lede } = Astro.props;
---

<header class="page-hero">
  <img src={site.images.band} alt="" width="1112" height="340" />
  <div class="wrap">
    <p class="kicker">{kicker}</p>
    <h1>{title}</h1>
    <p class="lede">{lede}</p>
  </div>
</header>
