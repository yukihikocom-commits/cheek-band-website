---
import { site, isCurrent } from '../lib/content';

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-bar">
    <a class="brand" href="/">
      <img
        src={site.images.logoSmall}
        alt={site.images.logoAlt}
        width="640"
        height="215"
      />
      <span>
        <span class="brand-name">Band</span>
        <span class="brand-sub">Chargers</span>
      </span>
    </a>
    <input class="nav-check" type="checkbox" id="nav-toggle" />
    <label class="nav-toggle" for="nav-toggle">
      <span class="when-closed">Menu</span>
      <span class="when-open">Close</span>
    </label>
    <nav class="site-nav" id="site-nav" aria-label="Primary">
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(path, item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="charger-bar" aria-hidden="true"></div>
</header>
